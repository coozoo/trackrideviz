{
    "format": "rtvgauge",
    "version": 1,
    "name": "Circle readout",
    "size": [
        300,
        300
    ],
    "supportedTypes": [
        "grade",
        "temperature",
        "speed",
        "cadence",
        "heartRate",
        "power"
    ],
    "components": [
        {
            "type": "image",
            "image": "images/plate.svg",
            "frame": [
                0,
                0,
                300,
                300
            ],
            "color": "original"
        },
        {
            "type": "image",
            "image": "images/track.svg",
            "frame": [
                0,
                0,
                300,
                300
            ],
            "color": "original"
        },
        {
            "type": "image",
            "image": "images/fill.svg",
            "frame": [
                0,
                0,
                300,
                300
            ],
            "color": "original",
            "manipulations": [
                {
                    "type": "radialClip",
                    "minAngle": 140,
                    "maxAngle": 40,
                    "pivot": [
                        150,
                        140
                    ]
                }
            ]
        },
        {
            "type": "text",
            "autoText": "value",
            "frame": [
                150,
                132
            ],
            "font": {
                "family": "Barlow Semi Condensed",
                "size": 60,
                "bold": true,
                "italic": true
            },
            "color": "foreground",
            "align": "center",
            "valign": "center",
            "precision": 0
        },
        {
            "type": "text",
            "autoText": "unit",
            "frame": [
                150,
                186
            ],
            "font": {
                "family": "Barlow Semi Condensed",
                "size": 22
            },
            "color": "accent2",
            "align": "center",
            "valign": "center"
        },
        {
            "type": "text",
            "autoText": "label",
            "frame": [
                150,
                280
            ],
            "font": {
                "family": "Barlow Semi Condensed",
                "size": 26,
                "italic": true
            },
            "color": "foreground",
            "align": "center",
            "valign": "center"
        }
    ]
}
