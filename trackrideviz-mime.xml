<?xml version="1.0" encoding="UTF-8"?>
<!-- The program's own files, so a double click opens them with it -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-trackrideviz-project">
    <comment>Race Track Visualizer project</comment>
    <comment xml:lang="uk">Проєкт Race Track Visualizer</comment>
    <sub-class-of type="application/json"/>
    <icon name="trackrideviz"/>
    <glob pattern="*.rtvproj"/>
  </mime-type>
  <mime-type type="application/x-trackrideviz-gauge">
    <comment>Race Track Visualizer gauge</comment>
    <comment xml:lang="uk">Індикатор Race Track Visualizer</comment>
    <sub-class-of type="application/gzip"/>
    <icon name="trackrideviz"/>
    <glob pattern="*.rtvgauge"/>
  </mime-type>
  <mime-type type="application/x-trackrideviz-template">
    <comment>Race Track Visualizer template</comment>
    <comment xml:lang="uk">Шаблон Race Track Visualizer</comment>
    <sub-class-of type="application/gzip"/>
    <icon name="trackrideviz"/>
    <glob pattern="*.rtvtemplate"/>
  </mime-type>
</mime-info>
